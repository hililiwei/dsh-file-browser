{
  "name": "@local/dsh-file-browser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browse the host filesystem and download any file from a left-sidebar panel in the DSH Web UI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/files": "./lib/files.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "test",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "repository": "github:hililiwei/dsh-file-browser",
  "homepage": "https://github.com/hililiwei/dsh-file-browser#readme",
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  }
}
